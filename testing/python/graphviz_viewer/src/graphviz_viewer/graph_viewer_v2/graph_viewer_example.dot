digraph Example {
    rankdir=LR;
    graph [ranksep=1.0, nodesep=0.35];
    node [shape=box];

    subgraph cluster_input {
        label="Input and parsing";

        n01 [label=<<B>Source file</B><BR/>Graphviz DOT input>];
        n02 [label="Read UTF-8"];
        n03 [label="Tokenize"];
        n04 [label="Parse graph"];
        n05 [label="Read defaults"];
        n06 [label="Read nodes"];
        n07 [label="Read edges"];
        n08 [label="Read clusters"];
        n09 [label="Normalize identifiers"];
        n10 [label="Assign unique IDs"];
        n11 [label="Collect metadata"];
        n12 [label="Convert rich labels"];
        n13 [label="Memoize rich text"];
        n14 [label="Build source hierarchy"];
        n15 [label="Validate references"];
        n16 [label="Parsing complete"];
        n17 [label="Report diagnostics"];
        n18 [label="Store graph properties"];
    }

    subgraph cluster_mapping {
        label="Hierarchy mapping";

        n19 [label="Start mapper"];
        n20 [label="Map root cluster"];
        n21 [label="Map child clusters"];
        n22 [label="Map source nodes"];
        n23 [label="Measure rich text"];
        n24 [label="Assign uniform width"];
        n25 [label="Compute node height"];
        n26 [label="Map source edges"];
        n27 [label="Inspect edge labels"];
        n28 [label=<<B>Split labeled edge</B><BR/>Create label node>];
        n29 [label="Create tail edge"];
        n30 [label="Create head edge"];
        n31 [label="Record related IDs"];
        n32 [label="Attach layout nodes"];
        n33 [label="Attach layout edges"];
        n34 [label="Attach layout clusters"];
        n35 [label="Mapping complete"];
        n36 [label="Validate hierarchy"];
    }

    subgraph cluster_layout {
        label="Graphviz layout";

        n37 [label="Create temporary graph"];
        n38 [label="Apply rank direction"];
        n39 [label="Emit fixed node sizes"];
        n40 [label="Emit constraints"];
        n41 [label="Run Graphviz dot"];
        n42 [label="Read plain output"];
        n43 [label="Parse node positions"];
        n44 [label="Parse edge splines"];
        n45 [label="Match parallel edges"];
        n46 [label="Compute cluster bounds"];
        n47 [label="Add cluster padding"];
        n48 [label="Convert global positions"];
        n49 [label="Assign relative positions"];
        n50 [label="Assign relative routes"];
        n51 [label="Layout complete"];
        n52 [label="Validate geometry"];
        n53 [label="Publish layout"];
        n54 [label="Notify model"];
    }

    subgraph cluster_ui {
        label="Qt presentation";

        n55 [label="Create item model"];
        n56 [label="Publish model roles"];
        n57 [label="Build hierarchy tree"];
        n58 [label="Build graphics scene"];
        n59 [label="Create cluster items"];
        n60 [label="Create edge items"];
        n61 [label="Create node items"];
        n62 [label="Render rich text"];
        n63 [label="Create arrowheads"];
        n64 [label="Fit graph in view"];
        n65 [label="Render minimap"];
        n66 [label="Handle selection"];
        n67 [label="Show properties"];
        n68 [label="Handle zoom"];
        n69 [label="Handle panning"];
        n70 [label="Change rank direction"];
        n71 [label="Re-run layout"];
        n72 [label="Refresh scene"];
    }

    n01 -> n02 -> n03 -> n04;
    n04 -> n05;
    n04 -> n06;
    n04 -> n07;
    n04 -> n08;
    n05 -> n09;
    n06 -> n09;
    n07 -> n09;
    n08 -> n09;
    n09 -> n10 -> n11 -> n12 -> n13 -> n14;
    n14 -> n15 -> n16;
    n15 -> n17;
    n14 -> n18;

    n16 -> n19 [label=<
        <TABLE BORDER="1" CELLBORDER="0">
            <TR><TD><B>Source hierarchy</B></TD></TR>
            <TR><TD>Nodes, edges and clusters</TD></TR>
        </TABLE>
    >];

    n19 -> n20 -> n21;
    n20 -> n22 -> n23 -> n24 -> n25;
    n20 -> n26 -> n27;
    n27 -> n28 [label="Label is not empty"];
    n28 -> n29 -> n30 -> n31;
    n25 -> n32;
    n31 -> n32;
    n32 -> n33 -> n34 -> n35 -> n36;

    n36 -> n37 [label="Layout hierarchy"];
    n37 -> n38 -> n39 -> n40 -> n41 -> n42;
    n42 -> n43;
    n42 -> n44;
    n44 -> n45;
    n43 -> n46;
    n45 -> n46;
    n46 -> n47 -> n48 -> n49 -> n50 -> n51;
    n51 -> n52 -> n53 -> n54;

    n54 -> n55 [label=<
        <B>Geometry ready</B><BR/>
        Relative cluster coordinates
    >];

    n55 -> n56;
    n55 -> n57;
    n55 -> n58;
    n58 -> n59;
    n58 -> n60;
    n58 -> n61;
    n61 -> n62;
    n60 -> n63;
    n59 -> n64;
    n60 -> n64;
    n61 -> n64;
    n64 -> n65;
    n61 -> n66 -> n67;
    n64 -> n68;
    n64 -> n69;
    n57 -> n66;
    n70 -> n71 -> n72;
    n72 -> n58;
}
