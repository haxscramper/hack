// Input facts describe model declarations, their source locations, and the
// expression trees attached to record-level and field-level checks.
.decl record(id: symbol, kind: symbol, file: symbol, line: number)
.decl inheritance(sub: symbol, sup: symbol)
.decl field(rec: symbol, name: symbol, type_id: symbol, required: symbol, has_default: symbol, file: symbol, line: number)
.decl field_default_key(rec: symbol, field_name: symbol, key_name: symbol, file: symbol, line: number)
.decl variant_case(rec: symbol, case_type: symbol)
.decl inline_variant_case(rec: symbol, field_name: symbol, case_type: symbol)
.decl enum_entry(rec: symbol, name: symbol)

// Type IDs identify both primitive and composite types. The category determines
// how elem1 and elem2 are interpreted; tuple elements use a separate indexed relation.
.decl type_info(type_id: symbol, category: symbol, elem1: symbol, elem2: symbol)
.decl tuple_elem(type_id: symbol, idx: number, elem_type: symbol)

// Expressions store operator-specific payloads and source locations.
// expr_arg provides ordered child edges; check relations identify expression roots.
.decl expr(id: number, op: symbol, str_val: symbol, int_val: number, type_val: symbol, file: symbol, line: number)
.decl expr_arg(parent: number, idx: number, arg_id: number)
.decl root_check(rec: symbol, expr_id: number, expected_cat: symbol)
.decl field_check(rec: symbol, field_name: symbol, expr_id: number)

.input record
.input inheritance
.input field
.input field_default_key
.input variant_case
.input inline_variant_case
.input enum_entry
.input type_info
.input tuple_elem
.input expr
.input expr_arg
.input root_check
.input field_check

// Compute reflexive, transitive inheritance: each record derives from itself,
// and a subclass also derives from every ancestor of its direct bases.
.decl derived_from(sub: symbol, sup: symbol)
derived_from(X, X) :- record(X, _, _, _).
derived_from(X, Z) :- inheritance(X, Y), derived_from(Y, Z).

// Expose fields declared directly on a record or on any of its ancestors.
// This is a union of declarations, not an override-precedence calculation.
.decl effective_field(rec: symbol, name: symbol, type_id: symbol)
effective_field(R, N, T) :- field(R, N, T, _, _, _, _).
effective_field(R, N, T) :- derived_from(R, Base), field(Base, N, T, _, _, _, _).

// Collect names accepted by variant operations, including case type IDs and
// fields exposed by cases. Inline variants are associated with their field type.
.decl effective_variant_case(var_type: symbol, case_name: symbol, case_type: symbol)

// Expose each declared case's effective fields as names on the variant.
effective_variant_case(R, FName, FType) :-
    variant_case(R, C),
    effective_field(C, FName, FType).

// Accept the case type ID itself as a case name.
effective_variant_case(R, C, C) :-
    variant_case(R, C).

// Resolve an inline variant's type through its containing field, then expose
// the effective fields of each associated case.
effective_variant_case(VarT, FName, FType) :-
    inline_variant_case(R, FieldN, C),
    effective_field(R, FieldN, VarT),
    effective_field(C, FName, FType).

// For records explicitly marked as cases, also accept the case type ID.
// ShortName is an alias for C here; no unqualified-name extraction is performed.
effective_variant_case(VarT, ShortName, C) :-
    inline_variant_case(R, FieldN, C),
    effective_field(R, FieldN, VarT),
    record(C, "case", _, _),
    ShortName = C.

// Track the types bound to This and Iter at each expression.
// "none" denotes the absence of an iterator binding.
.decl expr_scope(id: number, this_type: symbol, iter_type: symbol)

// Seed record-level roots with the record type and field-level roots with
// the field type. An expression present in both relations receives both scopes.
expr_scope(E, R, "none") :- root_check(R, E, _).
expr_scope(E, FT, "none") :- field_check(R, FN, E), effective_field(R, FN, FT).

// Ordinary operators pass both bindings unchanged to every argument.
expr_scope(Arg, ThisT, IterT) :-
    expr_scope(P, ThisT, IterT),
    expr(P, Op, _, _, _, _, _),
    Op != "all",
    Op != "map",
    expr_arg(P, _, Arg).

// The collection argument of all/map is evaluated in the enclosing scope.
expr_scope(CollArg, ThisT, IterT) :-
    expr_scope(P, ThisT, IterT),
    expr(P, Op, _, _, _, _, _),
    (Op = "all" ; Op = "map"),
    expr_arg(P, 0, CollArg).

// The body of all/map preserves This but rebinds Iter to the list element type.
// Scope propagation and expression typing are mutually recursive.
expr_scope(BodyArg, ThisT, ElemT) :-
    expr_scope(P, ThisT, _),
    expr(P, Op, _, _, _, _, _),
    (Op = "all" ; Op = "map"),
    expr_arg(P, 0, CollArg),
    expr_type(CollArg, CollT),
    type_info(CollT, "list", ElemT, _),
    expr_arg(P, 1, BodyArg).

// Infer expression result types from scope, operator payloads, and operand types.
// An expression without any inferred type is reported as invalid below.
.decl expr_type(id: number, type_id: symbol)

// Resolve contextual references; Iter is valid only when an iterator is bound.
expr_type(E, ThisT) :- expr(E, "this", _, _, _, _, _), expr_scope(E, ThisT, _).
expr_type(E, IterT) :- expr(E, "iter", _, _, _, _, _), expr_scope(E, _, IterT), IterT != "none".

// Literal types are fixed by their operators, independently of their payloads.
expr_type(E, "int64") :- expr(E, "const_int", _, _, _, _, _).
expr_type(E, "float64") :- expr(E, "const_float", _, _, _, _, _).
expr_type(E, "string") :- expr(E, "const_str", _, _, _, _, _).
expr_type(E, "bool") :- expr(E, "const_bool", _, _, _, _, _).

// Field access returns the declared or inherited field type of its operand.
expr_type(E, FT) :-
    expr(E, "get_field", FName, _, _, _, _),
    expr_arg(E, 0, ObjE),
    expr_type(ObjE, ObjT),
    effective_field(ObjT, FName, FT).

// Equality and inequality require operands with exactly matching type IDs.
expr_type(E, "bool") :-
    expr(E, Op, _, _, _, _, _),
    (Op = "eq" ; Op = "ne"),
    expr_arg(E, 0, A1),
    expr_arg(E, 1, A2),
    expr_type(A1, T1),
    expr_type(A2, T2),
    T1 = T2.

// Ordered comparisons require matching numeric categories, allowing different
// widths within integers or within floats, but not mixing the two categories.
expr_type(E, "bool") :-
    expr(E, Op, _, _, _, _, _),
    (Op = "lt" ; Op = "le"),
    expr_arg(E, 0, A1),
    expr_arg(E, 1, A2),
    expr_type(A1, T1),
    expr_type(A2, T2),
    type_info(T1, Cat, _, _),
    type_info(T2, Cat, _, _),
    (Cat = "int" ; Cat = "float").

// Binary logical operators require two boolean operands.
expr_type(E, "bool") :-
    expr(E, Op, _, _, _, _, _),
    (Op = "and" ; Op = "or"),
    expr_arg(E, 0, A1),
    expr_arg(E, 1, A2),
    expr_type(A1, "bool"),
    expr_type(A2, "bool").

// Logical negation requires a boolean operand.
expr_type(E, "bool") :-
    expr(E, "not", _, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, "bool").

// String length returns an int64.
expr_type(E, "int64") :-
    expr(E, "str_size", _, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, "string").

// Regex matching requires a string operand and returns a boolean.
// The pattern payload itself is not validated by this rule.
expr_type(E, "bool") :-
    expr(E, "str_regex", _, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, "string").

// Formatting returns a string when its first argument is a string.
// This rule does not constrain subsequent arguments or parse the format string.
expr_type(E, "string") :-
    expr(E, "str_format", _, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, "string").

// The list-size operation accepts lists and fixed arrays.
expr_type(E, "int64") :-
    expr(E, "list_size", _, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, T1),
    (type_info(T1, "list", _, _) ; type_info(T1, "array", _, _)).

// Map size requires a map operand and returns an int64.
expr_type(E, "int64") :-
    expr(E, "map_size", _, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, T1),
    type_info(T1, "map", _, _).

// Map membership requires the queried key to match the map's key type exactly.
expr_type(E, "bool") :-
    expr(E, "map_contains", _, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_arg(E, 1, A2),
    expr_type(A1, MapT),
    expr_type(A2, KeyT),
    type_info(MapT, "map", KeyT, _).

// Optional presence checks require an optional operand.
expr_type(E, "bool") :-
    expr(E, "opt_has_value", _, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, OptT),
    type_info(OptT, "optional", _, _).

// Unwrapping an optional yields its contained type; this checks types only,
// without proving that a runtime value is present.
expr_type(E, InnerT) :-
    expr(E, "opt_value", _, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, OptT),
    type_info(OptT, "optional", InnerT, _).

// A case test is valid when the operand exposes the requested case name.
expr_type(E, "bool") :-
    expr(E, "case_is", CaseName, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, VarT),
    effective_variant_case(VarT, CaseName, _).

// Retrieving a case name requires at least one effective case on the operand.
expr_type(E, "string") :-
    expr(E, "case_which", _, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, VarT),
    effective_variant_case(VarT, _, _).

// An enum comparison requires an entry declared on the operand's enum type.
expr_type(E, "bool") :-
    expr(E, "enum_is", EnumVal, _, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, EnumT),
    enum_entry(EnumT, EnumVal).

// Tuple access returns the type registered at the requested index.
expr_type(E, ElemT) :-
    expr(E, "nth_get", _, Idx, _, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, TupT),
    tuple_elem(TupT, Idx, ElemT).

// A derivation test is permitted when either type derives from the other,
// including the reflexive case; unrelated types receive no result type.
expr_type(E, "bool") :-
    expr(E, "is_derived", _, _, TargetT, _, _),
    expr_arg(E, 0, A1),
    expr_type(A1, ObjT),
    (derived_from(ObjT, TargetT) ; derived_from(TargetT, ObjT)).

// Universal quantification requires a list and a boolean predicate.
// The predicate's Iter binding is established by expr_scope.
expr_type(E, "bool") :-
    expr(E, "all", _, _, _, _, _),
    expr_arg(E, 0, CollE),
    expr_arg(E, 1, PredE),
    expr_type(CollE, CollT),
    type_info(CollT, "list", _, _),
    expr_type(PredE, "bool").

// Mapping requires a list and a body with an inferred type.
// The result deliberately erases the body's concrete type to list<any>.
expr_type(E, "list<any>") :-
    expr(E, "map", _, _, _, _, _),
    expr_arg(E, 0, CollE),
    expr_arg(E, 1, BodyE),
    expr_type(CollE, CollT),
    type_info(CollT, "list", _, _),
    expr_type(BodyE, _).

// Emit source-located diagnostics after deriving fields, cases, scopes, and types.
// Specific diagnostics can coexist with the generic missing-type diagnostic.
.decl validation_error(file: symbol, line: number, msg: symbol)
.output validation_error

// Report missing fields when the receiver's type is known.
validation_error(File, Line, cat("Field '", FName, "' in '", ObjT, "' does not exist")) :-
    expr(E, "get_field", FName, _, _, File, Line),
    expr_arg(E, 0, ObjE),
    expr_type(ObjE, ObjT),
    !effective_field(ObjT, FName, _).

// Report case names not exposed by the operand's inferred type.
validation_error(File, Line, cat("Invalid variant case '", CaseName, "' on type '", VarT, "'")) :-
    expr(E, "case_is", CaseName, _, _, File, Line),
    expr_arg(E, 0, ObjE),
    expr_type(ObjE, VarT),
    !effective_variant_case(VarT, CaseName, _).

// Report enum names absent from the operand's inferred type.
validation_error(File, Line, cat("Invalid enum value '", EnumVal, "' on enum '", EnumT, "'")) :-
    expr(E, "enum_is", EnumVal, _, _, File, Line),
    expr_arg(E, 0, ObjE),
    expr_type(ObjE, EnumT),
    !enum_entry(EnumT, EnumVal).

// Report indexed access when no tuple element exists at the requested index.
// This also matches known operand types with no tuple-element facts.
validation_error(File, Line, cat("Tuple index out of bounds on type '", TupT, "'")) :-
    expr(E, "nth_get", _, Idx, _, File, Line),
    expr_arg(E, 0, ObjE),
    expr_type(ObjE, TupT),
    !tuple_elem(TupT, Idx, _).

// Catch any expression reached by scope propagation that has no inferred type,
// including parent expressions whose operands could not be typed.
validation_error(File, Line, cat("Type error or invalid operand in expression op '", Op, "'")) :-
    expr(E, Op, _, _, _, File, Line),
    expr_scope(E, _, _),
    !expr_type(E, _).

// Check root results against their expected type IDs, typically bool for
// conditions and string for messages; ExpCat is compared directly to ActualT.
validation_error(File, Line, cat("Root check expression expected type '", ExpCat, "' but evaluated to '", ActualT, "'")) :-
    root_check(_, E, ExpCat),
    expr(E, _, _, _, _, File, Line),
    expr_type(E, ActualT),
    ActualT != ExpCat.

// For dictionary defaults on class-typed fields, require every supplied key
// to name a declared or inherited field of that class.
validation_error(File, Line, cat("Default dict key '", Key, "' for field '", FN, "' is not a valid field of '", FT, "'")) :-
    field(R, FN, FT, _, "true", _, _),
    field_default_key(R, FN, Key, File, Line),
    record(FT, "class", _, _),
    !effective_field(FT, Key, _).
